# Finance Crawler Job Container (Ephemeral)
# 호출 시 크롤링 수행 후 자동 종료됩니다.
# Backend가 docker run --rm 으로 실행하며, stdout으로 JSON Lines를 출력합니다.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        wget gnupg2 ca-certificates \
    && wget -q -O - https://dl.google.com/linux/linux_signing_key.pub \
       | gpg --dearmor -o /usr/share/keyrings/google-chrome.gpg \
    && echo "deb [arch=amd64 signed-by=/usr/share/keyrings/google-chrome.gpg] \
       http://dl.google.com/linux/chrome/deb/ stable main" \
       > /etc/apt/sources.list.d/google-chrome.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends google-chrome-stable \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 파이프라인 스크립트
COPY pipeline/ ./pipeline/

# 크롤러 소스
COPY crawlers/ ./crawlers/

# 데이터 레이크 모듈
COPY data_lake/ ./data_lake/

ENV PYTHONUNBUFFERED=1
ENV QDRANT_URL=http://qdrant:6333

ENTRYPOINT ["python", "pipeline/crawler_job.py"]
CMD ["--sources", "naver", "daum", "krx", "--markets", "KOSPI", "KOSDAQ"]
